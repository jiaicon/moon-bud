# ---- 服务器 ----
PORT=3000
NODE_ENV=development

# ---- 数据库 ----
# 宿主端口是 5433，不是 5432：本机可能已装有本地 PostgreSQL 服务占用 5432，
# 两者同时监听会让连接被本地实例接走。容器内始终是 5432。
# docker compose 里的 api 服务由 compose 覆盖为 host=postgres:5432。
POSTGRES_USER=moonbud
POSTGRES_PASSWORD=moonbud_dev
POSTGRES_DB=moonbud
DATABASE_URL=postgresql://moonbud:moonbud_dev@localhost:5433/moonbud

# ---- JWT ----
# 生产环境必须替换为随机值：openssl rand -hex 32
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=30d

# ---- 调度 ----
# 每分钟扫描提醒的 cron 开关。生产必须保持 true，否则提醒永远不会触发。
# e2e 把它设为 false（见 apps/api/test/setup-env.ts）：真实定时器会在测试
# 清库清到一半时醒来，制造与真实缺陷无关的错误。
SCHEDULER_ENABLED=true

# ---- 推送（uni-push 2.0，经 uniCloud 云函数 URL 化）----
# 两个都非空才启用推送，缺任一项即退回 NoopPushProvider（只写日志，App 关闭时
# 收不到任何通知），启动日志会写明当前用的是哪一条。
# 地址 = uniCloud 控制台里给云函数 push 配的 URL 化路径的完整 https 地址；
# 密钥 = 同一个随机串，云函数那侧存在环境变量 PUSH_TOKEN 里（两侧不一致时 api 日志
# 会直说是密钥不匹配，不会让人去查个推）。生成：openssl rand -hex 32
UNICLOUD_PUSH_URL=
UNICLOUD_PUSH_TOKEN=
# 为什么不是直连个推 REST：DCloud 规定 uni-push 2.0 服务端只能用云函数推送，
# 2.0 的应用也拿不到个推 MasterSecret。详见 apps/mobile/BUILD.md 第 7 节。
# 到点提醒是否也走服务端推送。**默认 true**：2026-10-22 真机验过 plus 的定时消息排上就撤不掉
# （clear() 只清通知栏里已经显示的那些），划掉 App 就整个不响，所以到点提醒由服务端发；
# 客户端在 cid 报进服务端的那一刻关掉本地排期，不会双弹（原因见 spec 第 3 节）。
# 设成 false 就退回"只有本地定时管到点"，服务端跳过这一类。
PUSH_REMINDER_DUE=true

# ---- 助手（一句话记录）----
# DeepSeek 的 API key。**只进服务器那一份 .env**（它不进 git），也不要贴进聊天、日志或工单：
# 这个口是按 token 计费的，谁拿到字符串谁就能花你的钱。
# 留空 = 整条通道关闭：POST /api/assistant/parse 一律回 503，启动日志会写明当前用的是哪一条。
# 申请地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# 模型名，成本口径按它算（spec"成本与配额"点的是 flash 那一档）。上游改了名就动这一行，不动代码。
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 每个登录用户每分钟几次，缺省或配成小于 1 的值都按 6 算。
# 为什么要限：注册口没有验证码，而助手口是个能白嫖算力的面——"必须登录 + 限流"是 spec 里的硬要求。
ASSISTANT_RATE_LIMIT=6
