{
  "rootDir": "../",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "tsconfig": "<rootDir>/tsconfig.json"
      }
    ]
  },
  "setupFiles": ["<rootDir>/test/setup-env.ts"],
  "moduleFileExtensions": ["js", "json", "ts"],
  "testTimeout": 30000
}
