{
	// pages数组中第一项表示应用启动页：未登录的人也从这里进首页，看的是真页面。
	"pages": [
		{
			"path": "pages/home/index",
			"style": {
				"navigationBarTitleText": "首页",
				"enablePullDownRefresh": true
			}
		},
		{
			"path": "pages/preview/index",
			"style": {
				"navigationBarTitleText": "功能教学"
			}
		},
		{
			"path": "pages/login/index",
			"style": {
				"navigationBarTitleText": "登录"
			}
		},
		{
			// 邀请二维码扫开就是这一页；必须注册，否则落地是个 404。
			"path": "pages/join/index",
			"style": {
				"navigationBarTitleText": "加入家庭"
			}
		},
		{
			"path": "pages/forgot-password/index",
			"style": {
				"navigationBarTitleText": "忘记密码"
			}
		},
		{
			"path": "pages/change-password/index",
			"style": {
				"navigationBarTitleText": "修改密码"
			}
		},
		{
			"path": "pages/family-select/index",
			"style": {
				"navigationBarTitleText": "家庭"
			}
		},
		{
			"path": "pages/child-form/index",
			"style": {
				"navigationBarTitleText": "添加孩子"
			}
		},
		{
			"path": "pages/event-list/index",
			"style": {
				"navigationBarTitleText": "记录",
				"enablePullDownRefresh": true
			}
		},
		{
			"path": "pages/event-form/index",
			"style": {
				"navigationBarTitleText": "记一笔"
			}
		},
		{
			"path": "pages/reminder-list/index",
			"style": {
				"navigationBarTitleText": "提醒",
				"enablePullDownRefresh": true
			}
		},
		{
			"path": "pages/reminder-form/index",
			"style": {
				"navigationBarTitleText": "提醒"
			}
		},
		{
			"path": "pages/notification-center/index",
			"style": {
				"navigationBarTitleText": "提醒中心",
				"enablePullDownRefresh": true
			}
		},
		{
			"path": "pages/family-settings/index",
			"style": {
				"navigationBarTitleText": "家庭设置"
			}
		},
		{
			"path": "pages/member-list/index",
			"style": {
				"navigationBarTitleText": "家庭成员"
			}
		},
		{
			"path": "pages/invite-qrcode/index",
			"style": {
				"navigationBarTitleText": "邀请家人"
			}
		},
		{
			"path": "pages/theme-settings/index",
			"style": {
				"navigationBarTitleText": "主题设置"
			}
		},
		{
			"path": "pages/dup-window-settings/index",
			"style": {
				"navigationBarTitleText": "重复提醒提示"
			}
		},
		{
			// 统计图表从首页进入，不占底部 Tab 的第 5 格（那一格留给育儿知识）。
			"path": "pages/stats/index",
			"style": {
				"navigationBarTitleText": "统计"
			}
		},
		{
			"path": "pages/profile/index",
			"style": {
				"navigationBarTitleText": "我的",
				"enablePullDownRefresh": true
			}
		}
	],
	"easycom": {
		"autoscan": true,
		"custom": {
			// uView Pro（npm 方式）组件自动引入；自研组件不走 easycom，页面里显式 import。
			"^u-(.*)": "uview-pro/components/u-$1/u-$1.vue"
		}
	},
	// 底部 Tab 固定 4 格（spec 第 9 节）。第 5 格「育儿知识」v1 不出现：
	// 只在这里留注释与位置，不注册空页面——空页面比没有页面更容易让人以为坏了。
	"tabBar": {
		"color": "#5B6B7A",
		"selectedColor": "#3F76B0",
		"backgroundColor": "#FFFFFF",
		"borderStyle": "black",
		// 这里的图标是构建期默认值（晨雾蓝·浅色）。原生 tabBar 不会给 PNG 着色，
		// 换主题时由 ThemeRoot 调 setTabBarItem 换成对应预设烘好的那一份，
		// 文件名与 src/theme/native-chrome.ts 的 tabBarItemPaths 一致，走散了两边都有测试守着。
		"list": [
			{
				"pagePath": "pages/home/index",
				"text": "首页",
				"iconPath": "static/tabbar/home-idle-mist-blue-light.png",
				"selectedIconPath": "static/tabbar/home-active-mist-blue-light.png"
			},
			{
				"pagePath": "pages/event-list/index",
				"text": "记录",
				"iconPath": "static/tabbar/record-idle-mist-blue-light.png",
				"selectedIconPath": "static/tabbar/record-active-mist-blue-light.png"
			},
			{
				"pagePath": "pages/reminder-list/index",
				"text": "提醒",
				"iconPath": "static/tabbar/reminder-idle-mist-blue-light.png",
				"selectedIconPath": "static/tabbar/reminder-active-mist-blue-light.png"
			},
			{
				"pagePath": "pages/profile/index",
				"text": "我的",
				"iconPath": "static/tabbar/profile-idle-mist-blue-light.png",
				"selectedIconPath": "static/tabbar/profile-active-mist-blue-light.png"
			}
			// 第 5 格预留：{ "pagePath": "pages/knowledge/index", "text": "育儿" }
		]
	},
	"globalStyle": {
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "月芽",
		"navigationBarBackgroundColor": "#F8F8F8",
		"backgroundColor": "#F8F8F8"
	}
}
